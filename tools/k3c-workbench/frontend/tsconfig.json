{
  // Typecheck des Frontends (wie das Hauptprojekt, plus JSX). Gemeinsame Bausteine über @webkit (tools/webkit); die Tests laufen mit vitest.config.ts (task check:dev).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@webkit/*": ["../../webkit/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@radix-ui/themes": ["./node_modules/@radix-ui/themes"]
    }
  },
  "include": ["src", "../../webkit"]
  // paths.ts, vite.config.ts und vitest.config.ts laufen unter Node (node:url) und bleiben ohne @types/node draußen.
}
