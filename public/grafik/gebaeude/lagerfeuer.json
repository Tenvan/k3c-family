{
  "id": "lagerfeuer",
  "vorlage": {
    "motiv": "Anfang des Hubs vor der Holzburg: Lagerfeuer mit Grill in der Mitte als Zahlziel, links wächst ein Zelt, dann eine Holzhütte (GEB11)",
    "teile": [
      "Links frei für Zelt (Stufe 2) oder Holzhütte (Stufe 3), etwa 0,25 bis 2,9 Kacheln",
      "Grill mittig: zwei Astgabeln (bei 2,9 und 4,9 Kacheln) mit Spieß und Braten",
      "Feuerstelle mittig unter dem Spieß: Flammen, gekreuzte Scheite, Steinring am Boden",
      "Holzstapel rechts (5,5 bis 6,75 Kacheln) aus fünf Stämmen mit Jahresring",
      "Stufe 2: helles Spitzzelt mit dunklem Eingang und Pflöcken",
      "Stufe 3: Holzhütte mit Ziegeldach, Kamin, erleuchtetem Fenster und Tür"
    ],
    "materialien": [
      "Pfosten, Balken",
      "Holz (Wand, Tresen, Gestell)",
      "Glut",
      "Stein (Kamin, Esse, Sockel, Stufe)",
      "Metall (Werkzeug)",
      "Zelttuch (Lager) = Stoff hell",
      "Dachziegel",
      "Fensterlicht"
    ],
    "stimmung": "kleiner Anfang wie in Kingdom Two Crowns: warm, abendlich, wächst sichtbar",
    "fein": "Funken, Fetttropfen, Steinfugen, Plankenfugen, Schindel-Fugen, Fenstersprossen"
  },
