{
  "id": "lager",
  "vorlage": {
    "motiv": "Offenes Lager: Holzschuppen mit Schindeldach auf Steinsockel, im offenen Inneren Kisten, Fässer, Säcke und Rohstoffe",
    "teile": [
      "Steinsockel über die ganze Breite am Boden, 0,75 Kacheln hoch, mit Fugen",
      "Pfosten links und rechts (x 0,25 und 5,5)",
      "Dunkle Holzrückwand im offenen Inneren",
      "Kistenstapel links (2 Kisten übereinander, ca. 1 Kachel breit)",
      "Zwei Fässer mit Reifen (großes, kleines) in der Mitte links",
      "Drei Säcke, zwei unten und einer oben aufgestapelt, Mitte rechts",
      "Holzscheit-Stapel und Erzbrocken rechts",
      "Dreistufiges Schindeldach aus Holz oben, Traufe dunkel"
    ],
    "materialien": [
      "Stein (Kamin, Esse, Sockel, Stufe)",
      "Holz (Wand, Tresen, Gestell)",
      "Pfosten, Balken",
      "Stoff hell",
      "Metall (Werkzeug)"
    ],
    "stimmung": "Ruhig und solide, ein gefüllter Vorrat; passt zur Steinmauer",
    "fein": "Steinfugen, Schindelfugen, Brettfugen der Rückwand, Kistenkreuze, Fass-Maserung, Sack-Falten, Holzmaserung, Erzglanz"
  },
  "kacheln": { "b": 6, "h": 4 },
