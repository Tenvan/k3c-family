{
  "id": "turm",
  "vorlage": {
    "motiv": "Schmaler Wehrturm, 3 Kacheln breit und 8 hoch, mit Plattform für Bogenschützen; Material wechselt je Stufe, Stufe 5 ist der Zaubertum",
    "teile": [
      "Vier Zinnen oben über die Plattform (ca. 0,4 Kacheln hoch)",
      "Brüstung über die ganze Breite, darunter Konsolen links und rechts",
      "Schaft mittig, 2,25 Kacheln breit, aus waagrechten Bohlen (ab Stufe 2 Quader), Licht links, Schatten rechts",
      "Zwei Schießscharten übereinander in der Mitte des Schafts",
      "Tür unten mittig mit Rahmen",
      "Sockel unten"
    ],
    "materialien": [
      "Holz (Wand, Tresen, Gestell)",
      "Pfosten, Balken",
      "Stein (Kamin, Esse, Sockel, Stufe)",
      "Kupfer (Mauer-, Turmstufe 3)",
      "Eisen hell (Mauer-, Turmstufe 4)",
      "Kristall (Mauer-, Turmstufe 5)"
    ],
    "stimmung": "wachsam und wehrhaft; gleiche Farbstufen wie die Mauer, damit Linie und Turm zusammenpassen",
    "fein": "Bohlen- und Quaderfugen, Türfugen, Patina-Tupfen, Nieten, Runen, Glanzpunkte"
  },
  "kacheln": {
    "b": 3,
    "h": 8
  },
