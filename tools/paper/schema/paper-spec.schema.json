{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k3c.local/paper/paper-spec.schema.json",
  "title": "Paper-Spec v1 (<asset>.paper.json)",
  "description": "Ein Asset der Papierschnitt-Grafik. Koordinaten in Spec-Einheiten, Boden y = 0, Blick nach rechts. Fachliche Regeln, die das Schema nicht ausdrückt: tools/paper/schema/check.ts; Standard: docs/standards/paper-spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rig", "version", "beschreibung", "teile", "ausgabe"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "description": "= Dateiname ohne .paper.json", "$ref": "#/$defs/name" },
    "rig": { "enum": ["figur", "vierbeiner", "gebaeude", "requisite", "hintergrund"] },
    "version": { "type": "integer", "minimum": 1 },
    "beschreibung": { "description": "Absicht in Worten; verbindlich sind die Teile", "type": "string", "minLength": 1 },
    "teile": { "description": "Zeichenreihenfolge = Reihenfolge der Liste", "type": "array", "items": { "$ref": "#/$defs/teil" } },
    "umhang": { "$ref": "#/$defs/umhang" },
    "bein": { "$ref": "#/$defs/bein" },
    "animationen": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/animation" }
    },
    "varianten": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tausch"],
        "properties": { "tausch": { "$ref": "#/$defs/tausch" } }
      }
    },
    "stufen": {
      "description": "Nur gebaeude: Delta je weiterer Ausbaustufe (stufen[0] = Stufe 2)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "tausch": { "$ref": "#/$defs/tausch" },
          "zusaetze": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/teil" } }
        }
      }
    },
    "ausgabe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hoehe_px", "rahmen"],
      "properties": {
        "hoehe_px": { "description": "Frame-Höhe in Pixeln (Skalierung pc = 1)", "type": "integer", "minimum": 8, "maximum": 1024 },
        "rahmen": { "description": "[x, y, b, h] in Spec-Einheiten", "$ref": "#/$defs/rahmen" },
        "massstab": { "description": "Faktor Spec-Einheiten → Welt-Einheiten (Standard 1; Pferd 1.3)", "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "rig": { "not": { "const": "vierbeiner" } } } }, "then": { "properties": { "bein": false } } },
    { "if": { "properties": { "rig": { "not": { "const": "gebaeude" } } } }, "then": { "properties": { "stufen": false } } }
  ],
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "zahl": { "type": "number" },
    "punkt": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "rahmen": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
      "minItems": 4,
      "maxItems": 4
    },
    "material": { "description": "Name aus materialien oder einzeltoene der Stil-Datei", "$ref": "#/$defs/name" },
    "ton": { "enum": ["licht", "basis", "schatten"] },
    "form": { "description": "SVG-Pfad (Attribut d) in Spec-Einheiten", "type": "string", "pattern": "^[MmLlHhVvCcSsQqTtZz0-9eE.,+\\- ]+$" },
    "tausch": {
      "description": "Material → Material",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/material" }
    },
    "teil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pivot", "lagen"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "eltern": { "$ref": "#/$defs/name" },
        "pivot": { "$ref": "#/$defs/punkt" },
        "lagen": { "type": "array", "items": { "$ref": "#/$defs/lage" } }
      }
    },
    "lage": {
      "type": "object",
      "required": ["art"],
      "properties": { "art": { "enum": ["flaeche", "falz", "punkt"] } },
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["art", "form", "material"],
          "properties": {
            "art": { "const": "flaeche" },
            "form": { "$ref": "#/$defs/form" },
            "material": { "$ref": "#/$defs/material" },
            "ton": { "$ref": "#/$defs/ton" },
            "auflage": { "description": "aufgeklebte Lage (kleiner Schatten papier.auflage) statt eigenes Papierstück", "type": "boolean" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["art", "form", "breite", "material"],
          "properties": {
            "art": { "const": "falz" },
            "form": { "$ref": "#/$defs/form" },
            "breite": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
            "material": { "$ref": "#/$defs/material" },
            "ton": { "$ref": "#/$defs/ton" }
          }
        },
        {
          "additionalProperties": false,
          "required": ["art", "mitte", "radius", "material"],
          "properties": {
            "art": { "const": "punkt" },
            "mitte": { "$ref": "#/$defs/punkt" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "material": { "$ref": "#/$defs/material" },
            "ton": { "$ref": "#/$defs/ton" }
          }
        }
      ]
    },
    "umhang": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anker", "punkt", "material", "laenge", "breite"],
      "properties": {
        "anker": { "description": "Teil, an dem der Umhang hängt", "$ref": "#/$defs/name" },
        "punkt": { "$ref": "#/$defs/punkt" },
        "material": { "$ref": "#/$defs/material" },
        "laenge": { "type": "number", "exclusiveMinimum": 0 },
        "breite": {
          "description": "[oben, unten]",
          "type": "array",
          "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }],
          "minItems": 2,
          "maxItems": 2
        },
        "segmente": { "type": "integer", "minimum": 2, "maximum": 32 }
      }
    },
    "bein": {
      "description": "Nur vierbeiner: Breite des Beinpfads an Schulter, Hüfte, Oberschenkel, Knie, Unterbein, Fessel",
      "type": "object",
      "additionalProperties": false,
      "required": ["breiten_vorn", "breiten_hinten"],
      "properties": {
        "breiten_vorn": { "$ref": "#/$defs/breiten" },
        "breiten_hinten": { "$ref": "#/$defs/breiten" }
      }
    },
    "breiten": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 }, "minItems": 6, "maxItems": 6 },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames"],
      "properties": {
        "frames": { "type": "integer", "minimum": 1, "maximum": 64 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 60 },
        "reittier": { "description": "id eines vierbeiner-Assets", "$ref": "#/$defs/name" },
        "gangart": { "enum": ["schritt", "trab", "galopp"] },
        "keyframes": {
          "description": "Eigene Pose: zyklisch, linear interpoliert",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t", "winkel"],
            "properties": {
              "t": { "type": "number", "minimum": 0, "maximum": 1 },
              "winkel": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "type": "number" } }
            }
          }
        }
      }
    }
  }
}
