  "id": "treppe-runter",
  "vorlage": {
    "motiv": "Steinbogen mit Zinnen über dem Eingang eines Abgangs; im dunklen Bogen führen Stufen nach unten",
    "teile": [
      "Steinwand 4 Kacheln breit mit vier Zinnen oben, Licht links und oben, Schattenkante unter der Zinnenreihe",
      "Pfeiler links und rechts mit versetzten Fugen",
      "Heller Bogenring um eine schwarze Öffnung (Mitte, ca. 2,5 Kacheln breit), Schlussstein oben",
      "Im Bogen drei Stufen nach unten: vorn hell, nach hinten immer dunkler, zuletzt Schwarz",
      "Dunkle Fußlinie an den Pfeilern"
    ],
    "materialien": [
      "Stein (Kamin, Esse, Sockel, Stufe)"
    ],
    "stimmung": "Düster und einladend zugleich: Der Weg führt hinab, passt zur Steinmauer",
    "fein": "Steinfugen, letzte Stufe im Dunkeln"
  },
