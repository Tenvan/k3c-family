{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k3c.local/paper/prompts.schema.json",
  "title": "Prompt-Vorlagen der Asset-Arbeit (data/asset-prompts.json)",
  "description": "Liste der Vorlagen; Platzhalter {asset} {rig} {teil} {pfad} {zustand} {basis} {eingabe} {material} {ton} {slot} {datei} {pack} {lizenz} {treffer}. Vertrag: docs/standards/paper-mcp.md › Prompt-Vorlagen.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "titel", "ort", "text"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "titel": { "type": "string", "minLength": 1, "maxLength": 40 },
      "ort": { "description": "Wo der Prompt-Button steht", "enum": ["asset", "teil", "review", "material", "ton", "papier", "sound", "datei", "treffer"] },
      "text": { "type": "string", "minLength": 1 }
    }
  }
}
