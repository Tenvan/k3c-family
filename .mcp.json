{
  "mcpServers": {
    "k3c-workbench": {
      "type": "http",
      "url": "http://127.0.0.1:${K3C_DEV_PORT:-5180}/mcp",
      "timeout": 900000,
      "headersHelper": "node -p \"JSON.stringify({'X-K3C-Root': process.cwd()})\""
    },
    "k3c-studio": {
      "type": "http",
      "url": "http://127.0.0.1:${K3C_STUDIO_PORT:-5181}/mcp",
      "timeout": 900000,
      "headersHelper": "node -p \"JSON.stringify({'X-K3C-Root': process.cwd()})\""
    }
  }
}
