  "id": "treppe-hoch",
  "vorlage": {
    "motiv": "Steinerne Außentreppe, die von links unten nach rechts oben steigt, mit Holzgeländer und einer Laterne am oberen Absatz",
    "teile": [
      "Acht Stein-Stufen von links (niedrig) nach rechts (hoch), je 0,5 Kacheln breit und 0,3125 hoch, Auftritt hell, Schattenkante darunter",
      "Steinkörper unter den Stufen bis zum Boden mit versetzten Fugen",
      "Dunkle Fußlinie am Boden",
      "Holzgeländer entlang der Steigung: Pfosten je Stufe, oberer Holm und unterer Holm folgen den Stufen",
      "Pfosten mit Laterne am oberen Absatz rechts (Licht = hinauf)"
    ],
    "materialien": [
      "Stein (Kamin, Esse, Sockel, Stufe)",
      "Holz (Wand, Tresen, Gestell)",
      "Pfosten, Balken",
      "Fensterlicht"
    ],
    "stimmung": "Einladend und solide; passt zur Steinmauer, die Laterne markiert das Ziel oben",
    "fein": "Steinfugen, Holm-Glanz"
  },
