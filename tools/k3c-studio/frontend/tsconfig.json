{
  // Typecheck des Asset-Studio-Frontends (wie k3c-dev). Spiel-Code und Daten nur über @game (src/) und @data (data/);
  // die importierten Dateien aus src/ prüft dieser Typecheck mit. Die Tests laufen mit vitest.config.ts (task check:studio).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@game/*": ["../../../src/*"],
      "@data/*": ["../../../data/*"],
      "@webkit/*": ["../../webkit/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@radix-ui/themes": ["./node_modules/@radix-ui/themes"]
    }
  },
  "include": ["src", "../../webkit", "paths.ts", "vite.config.ts", "vitest.config.ts"]
}
