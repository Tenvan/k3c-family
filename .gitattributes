# Zeilenenden: Im Repo immer LF. Auf Windows (core.autocrlf=true) liegt der Arbeitsbaum mit CRLF vor,
# auf Linux/CI/Docker mit LF. Git entscheidet je Datei selbst, was Text ist.
* text=auto

# Skripte und Container-Dateien laufen unter Linux und brauchen LF auch im Arbeitsbaum.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binärdateien nie umwandeln.
*.png binary
*.ogg binary
*.mp3 binary
*.wav binary
*.exe binary
*.ico binary
*.woff2 binary

# Gepackte Golden-Dateien (GD1, B-624): binär, lesbarer Diff über `task golden-setup` (textconv gzip -dc).
*.json.gz binary diff=gzip

# Rig-Export (task gen:rig) schreibt LF; im Arbeitsbaum auch LF, sonst erscheint jeder Export als Scheinänderung.
public/rig/**/*.json text eol=lf

# Papierschnitt-Generator (task gen:paper) schreibt Golden und Gruppen-Index mit LF; im Arbeitsbaum auch LF, sonst erscheint jeder Build als Scheinänderung.
public/grafik/**/golden.json text eol=lf
public/grafik/**/index.paper.json text eol=lf
