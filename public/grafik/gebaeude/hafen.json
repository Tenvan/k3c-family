{
 "id": "hafen",
 "vorlage": {
  "motiv": "Hafen-Steg in der Vorderansicht: Steinkai mit Flaggenmast links, Holzsteg auf Pfählen über Wasser mit Pollern, Fass, Kisten und Laterne",
  "teile": [
   "Steinkai links (x 0 bis 1,5, Oberkante y 2,5) aus grauen Quadern, darauf ein Flaggenmast mit blauem Wimpel",
   "Holzsteg rechts (x 1,5 bis 6) mit hellen Planken oben, dunkler Kante darunter und Plankenfugen",
   "Vier Pfähle (x 1,75 bis 5,5) im Wasser unter dem Steg, Wasserstreifen mit hellen Wellenstrichen",
   "Zwei eiserne Poller auf dem Steg (x 2 und 5)",
   "Fass mit Eisenreifen (x 3 bis 3,7) und zwei gestapelte Kisten (x 3,9 bis 4,4)",
   "Laternenmast am Stegende (x 5,75) mit leuchtender Laterne"
  ],
  "materialien": [
   "Holz (Wand, Tresen, Gestell)",
   "Pfosten, Balken",
   "Stein (Kamin, Esse, Sockel, Stufe)",
   "Eisen (Rüstung, Band)",
   "Wasser (Schale, Trog)",
   "Fensterlicht"
  ],
  "stimmung": "Ruhiger Hafen am Morgen, kühles Wasser, warmes Holz, ein Licht am Stegende",
  "fein": "Quaderfugen, Plankenfugen, Wellenstriche, Fassdauben"
 },
