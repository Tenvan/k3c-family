{
  "name": "k3c",
  "private": true,
  "version": "0.1.0",
  "description": "Family Three Crowns - Couch-Koop Side-Scroller (Browser / Xbox Edge)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts",
    "preview": "vite preview --host",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:go": "go test ./... && golangci-lint run",
    "check:dev": "npm --prefix tools/k3c-dev/frontend run build && cd tools/k3c-dev && go test ./... && golangci-lint run",
    "k3c-dev": "cd tools/k3c-dev && wails dev",
    "k3c-dev:build": "cd tools/k3c-dev && wails build",
    "serve": "npm run build && node server/server.mjs",
    "start": "node server/server.mjs",
    "serve:go": "npm run build && go run ./cmd/k3c-server"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
