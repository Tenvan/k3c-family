{
 "id": "schiff",
 "vorlage": {
  "motiv": "Segelschiff im Bau in der Seitenansicht: Stufe 1 Kiel mit Steven und Spanten auf der Helling, Stufe 2 mit Holzrumpf, Schilden und Ruder, Stufe 3 fertig mit Mast und rot-hellem Segel auf dem Wasser",
  "teile": [
   "Kiel als lange dunkle Planke (x 1 bis 5,5, y 4,1) mit Heck- und Bugsteven, links niedrig, rechts hochgezogen",
   "Sieben Spanten (x 1,25 bis 5,1) stehen senkrecht auf dem Kiel, ihre Oberkante folgt dem Bug nach oben",
   "Drei Stützklötze der Helling unter dem Kiel (Stufe 3: im Wasser versunken)",
   "Stufe 2: Rumpf aus Holzplanken (x 0,75 bis 5,75) mit roter Reling, vier Schilden an der Bordwand, Ruder am Heck und Bugfigur",
   "Stufe 3: Mast mittig (x 3) mit Rah und großem Segel (x 1,5 bis 4,75) mit zwei roten Bahnen, Wimpel an der Mastspitze",
   "Wasserstreifen vorn (y 4,5 bis 5) mit hellen Wellenstrichen"
  ],
  "materialien": [
   "Holz (Wand, Tresen, Gestell)",
   "Pfosten, Balken",
   "Stoff hell",
   "Stoff rot",
   "Wasser (Schale, Trog)",
   "Wappen"
  ],
  "stimmung": "Werft am Hafen, warmes Holz, das fertige Schiff ist hell und festlich",
  "fein": "Plankenfugen, Wellenstriche, Segelnähte, Schildzier"
 },
