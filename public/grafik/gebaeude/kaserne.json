{
 "id": "kaserne",
 "vorlage": {
  "motiv": "Steinerne Kaserne mit Zinnen, breitem Holztor und Wimpel am Dach, daneben ein Waffenständer mit Speeren und Schwertern",
  "teile": [
   "Wimpel rot am Mast links auf dem Dach, ca. x 0,6 bis 1,3, y 0 bis 1",
   "Steinhaus mit Zinnen oben, Quaderfugen und Sockel, x 0,25 bis 4,25, y 1 bis 4",
   "Zwei Schießscharten links und rechts oben in der Wand",
   "Breites Holztor mittig, x 1,2 bis 3,3, mit Balkenrahmen, Planken und zwei Eisenbändern mit Nieten",
   "Waffenständer rechts, x 4,4 bis 5,9, niedrig bis y 2,2, mit zwei Speeren und zwei Schwertern"
  ],
  "materialien": [
   "Stein (Kamin, Esse, Sockel, Stufe)",
   "Holz (Wand, Tresen, Gestell)",
   "Pfosten, Balken",
   "Eisen (Rüstung, Band)",
   "Metall (Werkzeug)",
   "Stoff rot"
  ],
  "stimmung": "wehrhaft und geordnet, Steinbau passend zur Mauer",
  "fein": "Quaderfugen, Plankenfugen, Nieten, Tor-Beschlag, Faltenlicht im Wimpel, Waffenglanz"
