{
  // Typecheck der Repo-Wurzel: tests/ (B-033) und tools/paper/ (Papierschnitt-Renderer unter bun, PV1.3). Der Browser-Client
  // src/ ist entfernt (B-848).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tests", "tools/paper", "vitest.config.ts"]
}
