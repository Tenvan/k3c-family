{
  "id": "geruest-4",
  "vorlage": {
    "motiv": "Baugerüst aus Holz in Gebäudeform für Bauplätze der Breite 4 Kacheln im Bau (GEB16, B-586): Farm und Treppen (4 × 3 bzw. 4 × 4)",
    "teile": [
      "Unfertige Steinwand hinten, links höher als rechts, bis 0,90625 Kacheln über dem Boden",
      "3 Stangen über die Breite, von 0,25 Kacheln bis zum Boden",
      "Laufbretter über die ganze Breite auf 0,75, 2,25 Kacheln, darunter je ein Riegel",
      "Diagonale Streben in den äußeren Feldern, je Ebene die Richtung wechselnd",
      "Leiter rechts der Mitte vom untersten Brett bis zum Boden"
    ],
    "materialien": [
      "Pfosten, Balken",
      "Holz (Wand, Tresen, Gestell)",
      "Stein (Kamin, Esse, Sockel, Stufe)"
    ],
    "stimmung": "Baustelle: hier entsteht ein Gebäude",
    "fein": "Steinfuge, Licht an Stangen und Brettern, Brettschatten"
  },
  "kacheln": {
    "b": 4,
    "h": 3
  },
