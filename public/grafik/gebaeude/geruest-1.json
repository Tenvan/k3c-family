{
  "id": "geruest-1",
  "vorlage": {
    "motiv": "Baugerüst aus Holz in Gebäudeform für Bauplätze der Breite 1 Kacheln im Bau (GEB16, B-586): Mauer (1 × 5)",
    "teile": [
      "Unfertige Steinwand hinten, links höher als rechts, bis 1,5 Kacheln über dem Boden",
      "2 Stangen über die Breite, von 0,25 Kacheln bis zum Boden",
      "Laufbretter über die ganze Breite auf 0,75, 2,25, 3,75 Kacheln, darunter je ein Riegel",
      "Diagonale Streben in den äußeren Feldern, je Ebene die Richtung wechselnd"
    ],
    "materialien": [
      "Pfosten, Balken",
      "Holz (Wand, Tresen, Gestell)",
      "Stein (Kamin, Esse, Sockel, Stufe)"
    ],
    "stimmung": "Baustelle: hier entsteht ein Gebäude",
    "fein": "Steinfuge, Licht an Stangen und Brettern, Brettschatten"
  },
