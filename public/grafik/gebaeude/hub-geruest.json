{
  "id": "hub-geruest",
  "vorlage": {
    "motiv": "Baugerüst aus Holz als Bild vor der Burg, solange ein Bauer den Hub-Ausbau baut (GEB11), sonst transparent",
    "teile": [
      "Vier Stangen bei 0,2, 2,2, 5,7 und 7,7 Kacheln von 2,25 Kacheln bis zum Boden",
      "Laufbretter auf 4, 5,75 und 7,75 Kacheln über die ganze Breite, das untere lässt das Tor frei",
      "Diagonale Streben in den beiden äußeren Feldern",
      "Leiter rechts vom Tor vom mittleren Brett bis zum Boden",
      "Steinhaufen links unten, Kiste rechts neben dem Tor"
    ],
    "materialien": [
      "Pfosten, Balken",
      "Holz (Wand, Tresen, Gestell)",
      "Stein (Kamin, Esse, Sockel, Stufe)"
    ],
    "stimmung": "Baustelle: hier wird gerade ausgebaut",
    "fein": "Steinfuge, Kistenfuge"
  },
  "kacheln": {
    "b": 8,
    "h": 9
  },
